<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- 查分器代理 / 联网搜索 / Agent 联网需要网络 -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- 机台成绩更新（VPN 方案）：本地 VPN 抓取机台接口数据 -->
    <uses-permission android:name="android.permission.BIND_VPN_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <!-- 谱面后台播放：媒体通知前台服务（mediaPlayback 类型） -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
        <!-- WeChatJump 仅需拉起微信，声明包名查询即可，替代 QUERY_ALL_PACKAGES 全盘可见 -->
    <queries>
        <package android:name="com.tencent.mm" />
    </queries>
    <!-- 应用内更新：下载 GitHub Release 的 APK 并唤起安装器 -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- 机台成绩更新（二维码导入）：摄像头实时扫码（无摄像头设备不强制） -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />


    <application
        android:name=".KibaApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Kiba"
        tools:targetApi="35">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|keyboardHidden|uiMode"
            android:theme="@style/Theme.Kiba"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 机台成绩更新：本地 VPN 服务 + 本地 HTTP 跳转服务 -->
        <!--
            foregroundServiceType="specialUse"：抓包要撑到微信授权回调（用户切到微信时
            App 在后台），必须前台化，否则后台 Service 约 1 分钟就被系统停掉，VPN 跟着掉线。
            VPN 没有专用的 FGS type，按社区惯例用 specialUse。
        -->
        <service
            android:name=".core.vpn.core.LocalVpnService"
            android:exported="false"
            android:foregroundServiceType="specialUse"
            android:permission="android.permission.BIND_VPN_SERVICE">
            <intent-filter>
                <action android:name="android.net.VpnService" />
            </intent-filter>
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="vpn_capture_for_machine_score_sync" />
        </service>

        <!-- 历史遗留：HTTP 跳转服务现由 LocalVpnService 内联托管，这里保留声明仅为兼容 -->
        <service android:name=".core.vpn.server.HttpServerService" />

        <!--
            谱面后台播放：预览页（WebView）返回后仍在播时保留 WebView 并拉起本服务，
            以媒体通知提供 播放-暂停/快退/快进/停止。mediaPlayback 是官方专用 FGS 类型。
        -->
        <service
            android:name=".core.playback.ChartPlaybackService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />

        <!--
            乐曲播放：曲目详情「播放乐曲」/ 播放页（MediaPlayer 整轨）在后台时拉起本服务，
            以媒体通知提供 播放-暂停/上一首/下一首/停止/拖动进度。mediaPlayback 是官方专用 FGS 类型。
        -->
        <service
            android:name=".core.playback.SongPlaybackService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />

        <!-- 应用内更新：私有目录更新包的 FileProvider（updates/） -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>
